# Copy to .env and fill in your n8n webhook URLs (from n8n workflow Production Webhook).
# Do not commit .env.

# Send email workflow (path e.g. openclaw-send-email)
N8N_WEBHOOK_SEND_EMAIL=http://127.0.0.1:5678/webhook/openclaw-send-email

# Email to Trash: when user deletes a draft, save it to Gmail Trash (create draft then trash via Gmail API)
# N8N_WEBHOOK_EMAIL_TO_TRASH=http://127.0.0.1:5678/webhook/email-to-trash

# Approval bot (separate bot for draft Approve/Edit/Delete buttons). Create via BotFather, then /start the bot once.
# TELEGRAM_APPROVAL_BOT_TOKEN=your-approval-bot-token

# Optional: if n8n webhook requires auth
# N8N_WEBHOOK_SECRET=your-secret
